{
  "name": "alexprice-site",
  "description": "Alex Price's personal site — server-rendered Preact JSX on Bun.",
  "version": "0.1.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun run build:client && bun run build:css",
    "build:client": "bun build ./src/client/main.ts --outdir ./dist/assets --minify",
    "build:css": "bun build ./src/client/style.css --outdir ./dist/assets --entry-naming main.css --minify",
    "start": "bun --no-env-file run src/server/main.ts",
    "dev": "bun run build && bun run --parallel --no-orphans dev:client dev:server dev:css",
    "dev:client": "bun --watch build ./src/client/main.ts --outdir ./dist/assets",
    "dev:server": "bun --watch run src/server/main.ts",
    "dev:css": "bun build ./src/client/style.css --outdir ./dist/assets --entry-naming main.css --watch",
    "test": "NODE_ENV=test bun test --isolate src",
    "commit": "git add --all && git commit",
    "wip": "bash scripts/wip",
    "lint": "biome check src",
    "lint:write": "biome check src --write",
    "typecheck": "bun --bun tsc --noEmit",
    "check": "bun run lint && bun run typecheck",
    "audit": "bun audit --audit-level=high",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.5",
    "husky": "9.1.7",
    "railway": "^3.13.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "preact": "^11.0.0",
    "preact-render-to-string": "^6.8.0"
  }
}
