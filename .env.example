# Copy to .env and adjust. Both variables are required; the server exits at boot
# without them.

# The port the server listens on.
PORT=3000

# The site's own origin, including the scheme and port. Every absolute URL is
# built from it: <link rel="canonical">, Open Graph tags, the sitemap, robots.txt's
# Sitemap line, and JSON-LD. In production it must be https://.
APP_URL=http://localhost:3000

# Optional — the canonical origin used for the same URLs when it differs from the
# deploy origin (a custom domain pointed at a Railway subdomain, say). Blank or
# unset means APP_URL's origin. Any other value must be an absolute http(s) URL;
# anything else is fatal at boot.
# SITE_URL=https://alexprice.dev

# Optional — let search engines index the site. Unset (or anything other than
# `true`) keeps the whole site out of Google: every response carries
# `X-Robots-Tag: noindex, nofollow`, every page renders
# `<meta name="robots" content="noindex, nofollow">`, and robots.txt drops its
# Sitemap line. Set it on the production host, and only there. Crawling stays
# allowed on purpose: a crawler has to fetch a page to be told noindex.
# ALLOW_INDEXING=true

# Optional — Contact for /.well-known/security.txt. A bare email is wrapped in
# mailto:; a mailto:/https:/tel: URI is used as-is. Defaults to a placeholder
# (security@<the canonical site host>). Set a monitored address before launch.
# SECURITY_CONTACT=security@alexprice.dev

# Optional — set to "true" to serve a 503 "under maintenance" page (with a
# Retry-After header) for every request except /health. Prefer flipping
# maintenance at your edge/CDN when you can; this is the in-app fallback.
# MAINTENANCE_RETRY_AFTER overrides the Retry-After value in seconds (default 3600).
# MAINTENANCE_MODE=true
# MAINTENANCE_RETRY_AFTER=3600
